model ApiRequestLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @db.Uuid
  method       String
  path         String
  statusCode   Int
  responseTime Int
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([statusCode])
  @@index([createdAt])
  @@index([path])
  @@map("api_request_logs")
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String @unique

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model Conversation {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String?

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("conversations")
}

model Message {
  id String @id @default(uuid()) @db.Uuid

  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    MessageRole
  content String

  providerModelId String?        @db.Uuid
  providerModel   ProviderModel? @relation(fields: [providerModelId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([providerModelId])
  @@map("messages")
}

enum ProviderType {
  OPENAI
  ANTHROPIC
  GOOGLE
  DEEPSEEK
  OTHER
}

model Provider {
  id         String          @id @default(uuid()) @db.Uuid
  name       String
  type       ProviderType
  apiKey     String?
  isActive   Boolean         @default(true)
  isDefault  Boolean         @default(false)
  apiBaseUrl String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  models     ProviderModel[]

  @@index([isDefault])
  @@map("providers")
}

model ProviderModel {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @db.Uuid
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  name     String
  modelId  String
  isActive Boolean @default(true)

  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, modelId])
  @@index([providerId])
  @@map("provider_models")
}

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SearchHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("search_history")
}

model SearchCache {
  id        String   @id @default(uuid()) @db.Uuid
  cacheKey  String   @unique
  query     String   @unique
  results   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("search_cache")
}

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  usages SubscriptionUsage[]

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionUsage {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime

  requestCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subscriptionId, periodStart])
  @@index([subscriptionId])
  @@index([periodStart])
  @@map("subscription_usages")
}

enum UserRole {
  USER
  ADMIN
}

model Role {
  id   String   @id @default(uuid()) @db.Uuid
  name UserRole @unique

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  email        String @unique
  passwordHash String

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  isActive Boolean @default(true)

  roleId String @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  sessions           Session[]
  verificationTokens EmailVerificationToken[]
  subscriptions      Subscription[]
  conversations      Conversation[]
  searchHistory      SearchHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@map("users")
}
